{
	"compilerOptions": {
		"target": "ESNext",
		"lib": [
			"ESNext"
		],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": [
			"node"
		],
		"strict": true,
		"noEmit": false,
		"rootDir": ".",
		"outDir": "../dist-electron",
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["**/*.mts"],
	"exclude": ["node_modules", "dev.mts"]
}
