{
	"name": "electron-excel-compare",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist-electron/main.mjs",
	"dependencies": {
		"@handsontable/react-wrapper": "^18.1.2",
		"@tauri-apps/api": "^2.12.3",
		"@tauri-apps/plugin-dialog": "^2.8.2",
		"@tauri-apps/plugin-opener": "^2.7.1",
		"antd": "^4.6.4",
		"aws-sdk": "^2.756.0",
		"daff": "^1.4.2",
		"handsontable": "^18.1.2",
		"normalize.css": "^8.0.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"xlsx": "^0.16.7",
		"xlsx-js-style": "^1.2.0"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^4.2.4",
		"@testing-library/react": "^9.5.0",
		"@testing-library/user-event": "^7.2.1",
		"@types/jest": "^27.5.2",
		"@types/node": "^22.12.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^6.1.2",
		"electron": "44.7.0",
		"electron-builder": "^26.15.3",
		"prettier": "^3.9.10",
		"sass": "^1.105.1",
		"typescript": "^5.5.4",
		"vite": "^8.3.4"
	},
	"scripts": {
		"dev-app": "node src-electron/dev.mts",
		"dev-web": "vite",
		"dev-tauri": "cargo tauri dev",
		"typecheck": "tsc --noEmit && tsc --noEmit -p src-electron",
		"build-web": "pnpm run typecheck && vite build",
		"build-elt": "pnpm run build-web && tsc -p src-electron",
		"build-electron-win": "pnpm run build-elt && electron-builder --win nsis --x64",
		"build-tauri": "cargo tauri build --no-bundle",
		"preview": "vite preview",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"volta": {
		"node": "22.23.3"
	},
	"packageManager": "pnpm@9.0.0",
	"build": {
		"appId": "com.midiplus.electron-excel-compare",
		"productName": "TS Excel Compare",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist-web/**/*",
			"dist-electron/**/*",
			"package.json"
		],
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true
		}
	}
}
